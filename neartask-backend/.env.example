# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (Postgres + PostGIS) ---
DATABASE_URL="postgresql://neartask:neartask_dev_password@localhost:5432/neartask?schema=public"

# --- Auth ---
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# --- Platform business rules (see PRD §6.6) ---
PLATFORM_COMMISSION_PERCENT=12
PRE_ACCEPT_REFUND_PERCENT=95

# --- Payment gateway (top-up collection only; payout is manual per PRD) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- Redis (sessions / real-time presence — wired in later once chat/live-location lands) ---
REDIS_URL="redis://localhost:6379"

# --- File storage (KYC documents) ---
# 'local' saves to ./uploads and serves it statically — dev/testing only.
# 's3' uses any S3-compatible bucket (Contabo Object Storage, Backblaze B2, Cloudflare R2, AWS S3).
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_BASE_URL=""
