generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────
// Users & trust
// ────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

// Matches PRD §7 — verification tiers gate what a user can do
enum VerificationTier {
  BASIC     // phone verified only — can post/apply to CHORE tasks
  VERIFIED  // ID + selfie match — can post/apply to SOCIAL tasks
  TRUSTED   // N completed gigs + good rating — priority placement
}

model User {
  id               String            @id @default(uuid())
  phone            String            @unique
  email            String?           @unique
  name             String
  passwordHash     String
  role             Role              @default(USER)
  kycStatus        KycStatus         @default(UNVERIFIED)
  verificationTier VerificationTier  @default(BASIC)

  // Privacy controls — PRD §6.4. Controls what OTHER users see, never what the platform stores.
  profileVisibility ProfileVisibility @default(FULL)

  gender           String?
  dateOfBirth      DateTime?

  trustScore       Float             @default(0)
  completedTasks   Int               @default(0)
  noShowCount      Int               @default(0)

  latitude         Float?
  longitude        Float?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  wallet           Wallet?
  tasksCreated     Task[]            @relation("CreatedTasks")
  applications     TaskApplication[]
  ratingsGiven     Rating[]          @relation("RatingsGiven")
  ratingsReceived  Rating[]          @relation("RatingsReceived")
  kycSubmissions   KycSubmission[]
}

enum ProfileVisibility {
  FULL     // name + photo visible
  PARTIAL  // first name + last initial, blurred photo
  HIDDEN   // anonymized display name until mutually confirmed
}

// ────────────────────────────────
// Wallet & ledger (PRD §6.6)
// ────────────────────────────────

model Wallet {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])

  // Two-balance model: Available (spendable/withdrawable) vs Locked (held in escrow)
  availableBalance Decimal  @default(0) @db.Decimal(12, 2)
  lockedBalance    Decimal  @default(0) @db.Decimal(12, 2)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transactions     WalletTransaction[]
}

enum TransactionType {
  TOPUP               // money added via payment gateway
  LOCK                // funds moved Available -> Locked at task posting
  REFUND_UNLOCK       // funds moved Locked -> Available on cancellation
  RELEASE_TO_DOER     // funds moved from creator's Locked -> doer's Available on completion
  COMMISSION          // platform's cut, recorded for accounting
  WITHDRAWAL_REQUEST  // doer requests payout (manual — PRD §6.6)
  WITHDRAWAL_PAID     // admin confirms manual transfer has actually gone out
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

// Append-only ledger. Never delete or mutate a row — corrections are new offsetting rows.
model WalletTransaction {
  id        String             @id @default(uuid())
  walletId  String
  wallet    Wallet             @relation(fields: [walletId], references: [id])
  type      TransactionType
  amount    Decimal            @db.Decimal(12, 2)
  status    TransactionStatus  @default(COMPLETED)
  taskId    String?
  task      Task?              @relation(fields: [taskId], references: [id])
  note      String?
  createdAt DateTime           @default(now())

  @@index([walletId])
  @@index([taskId])
}

// ────────────────────────────────
// Tasks (PRD §5, §6.1–§6.3, §8)
// ────────────────────────────────

enum TaskCategory {
  CHORE
  SOCIAL
}

enum TaskStatus {
  OPEN         // posted, funds locked, awaiting applicants
  SELECTED     // one applicant chosen, no refund possible from here per policy
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

model Task {
  id            String       @id @default(uuid())
  creatorId     String
  creator       User         @relation("CreatedTasks", fields: [creatorId], references: [id])

  category      TaskCategory
  title         String
  description   String
  price         Decimal      @db.Decimal(12, 2)

  latitude      Float
  longitude     Float
  radiusMeters  Int          @default(3000)

  scheduledAt   DateTime?
  status        TaskStatus   @default(OPEN)

  // Safety/comfort preferences — PRD §6.5 & §8: SOCIAL category only, enforced in service layer, never on CHORE.
  genderPreference String?
  minAge           Int?
  maxAge           Int?

  selectedApplicationId String?          @unique
  selectedApplication   TaskApplication? @relation("SelectedApplication", fields: [selectedApplicationId], references: [id])

  // Dispute flow (PRD §6.6 dispute row). Raised by either party while SELECTED/IN_PROGRESS;
  // resolved by an admin via /admin/disputes/:taskId/resolve.
  disputeReason   String?
  disputedById    String?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  applications  TaskApplication[] @relation("TaskApplications")
  transactions  WalletTransaction[]
  ratings       Rating[]

  @@index([status])
  @@index([category])
}

enum ApplicationStatus {
  PENDING
  SELECTED
  DECLINED
  WITHDRAWN
  NO_SHOW
}

model TaskApplication {
  id          String            @id @default(uuid())
  taskId      String
  task        Task              @relation("TaskApplications", fields: [taskId], references: [id])
  applicantId String
  applicant   User              @relation(fields: [applicantId], references: [id])
  note        String?
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())

  selectedForTask Task?         @relation("SelectedApplication")

  @@unique([taskId, applicantId]) // one application per user per task
  @@index([taskId])
}

// ────────────────────────────────
// KYC submissions (PRD §7, §12.6 — feeds VerificationTier)
// ────────────────────────────────

model KycSubmission {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  idDocumentUrl  String
  selfieUrl      String
  status         KycStatus @default(PENDING)
  adminNote      String?
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?

  @@index([userId])
  @@index([status])
}

// ────────────────────────────────
// Ratings (feeds trustScore — PRD §6.6)
// ────────────────────────────────

model Rating {
  id         String   @id @default(uuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id])
  fromUserId String
  fromUser   User     @relation("RatingsGiven", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("RatingsReceived", fields: [toUserId], references: [id])
  score      Int // 1-5
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([taskId, fromUserId, toUserId])
}
